# Copy to .env and replace locally. Never commit the populated file.
# Use a database hostname reachable FROM the container, not localhost.
NAVIS_DATABASE_URL=postgresql://navis:REPLACE_PASSWORD@db.example.internal:5432/navis
NAVIS_AUTH_MODE=local
NAVIS_LOCAL_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
NAVIS_LOCAL_ISSUER=navis-local
NAVIS_LOCAL_SUBJECT=local-test
NAVIS_LOCAL_SCOPES=inventory:write graph:read analysis:run analysis:read
