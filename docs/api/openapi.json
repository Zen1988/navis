  "components": {
    "schemas": {
      "Adapter": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "input_format": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Input Format"
          },
          "format_version": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Format Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "input_format",
          "format_version"
        ],
        "title": "Adapter"
      },
      "DeviceMapping": {
        "properties": {
          "navis_device_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Navis Device Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DeviceMapping"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Ingestion": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "device_mapping": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceMapping"
              },
              {
                "type": "null"
              }
            ]
          },
          "adapter": {
            "$ref": "#/components/schemas/Adapter"
          },
          "data_type": {
            "type": "string",
            "enum": [
              "device",
              "interface",
              "route",
              "policy",
              "nat",
              "neighbor",
              "mac",
              "topology",
              "security_zone"
            ],
            "title": "Data Type"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Collected At"
          },
          "completeness": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ],
            "title": "Completeness"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "adapter",
          "data_type",
          "collected_at",
          "completeness",
          "payload"
        ],
        "title": "Ingestion"
      },
      "Source": {
        "properties": {
          "namespace": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Namespace"
          },
          "external_device_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "External Device Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "namespace",
          "external_device_id"
        ],
        "title": "Source"
      },
      "TraceRequest": {
        "properties": {
          "graph_build_id": {
            "type": "string",
            "format": "uuid",
            "title": "Graph Build Id"
          },
          "caller_session_id": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Caller Session Id"
          },
          "source": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Source"
          },
          "destination": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Destination"
          },
          "protocol": {
            "type": "string",
            "maxLength": 16,
            "minLength": 1,
            "title": "Protocol"
          },
          "destination_port": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 65535.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination Port"
          },
          "source_port": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 65535.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Port"
          },
          "application": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Application"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "graph_build_id",
          "caller_session_id",
          "source",
          "destination",
          "protocol"
        ],
        "title": "TraceRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
