  "components": {
    "schemas": {
      "Adapter": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "input_format": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Input Format"
          },
          "format_version": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Format Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "input_format",
          "format_version"
        ],
        "title": "Adapter"
      },
      "DeviceMapping": {
        "properties": {
          "navis_device_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Navis Device Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DeviceMapping"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Ingestion": {
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "device_mapping": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviceMapping"
              },
              {
                "type": "null"
              }
            ]
          },
          "adapter": {
            "$ref": "#/components/schemas/Adapter"
          },
          "data_type": {
            "type": "string",
            "enum": [
              "device",
              "interface",
              "route",
              "policy",
              "nat",
              "neighbor",
              "mac",
              "topology",
              "security_zone"
            ],
            "title": "Data Type"
          },
          "collected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Collected At"
          },
          "completeness": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ],
            "title": "Completeness"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "collection_run_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
